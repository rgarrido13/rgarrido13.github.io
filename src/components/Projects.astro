---
const projects = [
  {
    title: "Respiratory Disease Early Warning System",
    description: "Built and deployed a real-time ML early-warning system, in collaboration with the CDC, that anticipates respiratory-disease outbreak onsets and peaks across all 50 US states — giving public-health officials earlier signals for decision-making. Detected 98% of onsets (~5 weeks ahead) and 97% of peaks (~2 weeks ahead) at 83% precision, narrowing historically unpredictable 10-20 week windows to a consistent 2-6 weeks.",
    tags: ["Transfer Learning", "Forecasting", "Anomaly Detection", "CDC"],
    statuses: ["Deployed", "Published"],
    link: "https://www.nature.com/articles/s41467-026-72655-7",
    linkLabel: "Read Paper",
  },
  {
    title: "Deep Learning for Diabetic Retinopathy Detection",
    description: "As an Applied Scientist at Joslin Diabetes Center, I'm turning this diabetic-retinopathy computer-vision system into a deployable product (targeting commercialization with Optos). I built a production model pipeline — several deep-learning models combined for high accuracy at low latency, re-engineered to cut memory and runtime — and support its deployment to the cloud (AWS). The underlying quality-control models reach 95% sensitivity and 99% specificity on 27,000+ clinical images.",
    tags: ["Computer Vision", "PyTorch", "Model Deployment", "AWS", "Medical Imaging"],
    statuses: ["Ongoing"],
    link: null,
    linkLabel: null,
  },
  {
    title: "Uncertainty Quantification in Outbreak Models",
    description: "Bayesian/MCMC inference pipeline for SEIR-based epidemiological models applied to real-world surveillance data. Reduces predictive uncertainty and informs public health decision-making.",
    tags: ["NumPyro", "MCMC", "Bayesian Inference", "SEIR"],
    statuses: ["Accepted"],
    link: "https://www.medrxiv.org/content/10.1101/2025.10.09.25337678v2.full.pdf",

    linkLabel: "Read Paper",
  },
  {
    title: "Job Search Agent",
    description: "A personal AI agent that automates my own job search — scouting roles, ranking fit against my background, and drafting tailored application materials — built with LLMs and tool-using agents.",
    tags: ["Python", "LLMs", "Agents"],
    statuses: ["In Progress"],
    link: null,
    linkLabel: null,
  },
];
---

<section id="projects">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <div class="card project-card">
          <div class="project-header">
            <h3>{project.title}</h3>
            <div class="status-group">
              {project.statuses.map((s) => (
                <span class={`status status-${s.toLowerCase().replace(' ', '-')}`}>
                  {s}
                </span>
              ))}
            </div>
          </div>
          <p>{project.description}</p>
          <div class="project-footer">
            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            {project.link && (
              <a href={project.link} target="_blank" class="project-link">
                {project.linkLabel} &rarr;
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .project-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .project-card p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .status {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .status-deployed {
    background: #dcfce7;
    color: #166534;
  }

  .status-published {
    background: #dbeafe;
    color: #1e40af;
  }

  .status-accepted {
    background: #ccfbf1;
    color: #115e59;
  }

  .status-ongoing {
    background: #fef3c7;
    color: #92400e;
  }

  .status-in-progress {
    background: #f3e8ff;
    color: #6b21a8;
  }

  .status-under-review {
    background: #fef3c7;
    color: #92400e;
  }

  .status-group {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-link {
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
